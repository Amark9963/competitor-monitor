# Copy to .env and fill in.

# Apify (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Anthropic. Optional if you've run `ant auth login`; the SDK picks up that profile.
ANTHROPIC_API_KEY=

# Optional: Slack incoming webhook for the digest
SLACK_WEBHOOK_URL=

# Optional overrides
# MONITOR_DB_PATH=data/monitor.db
# MONITOR_REPORTS_DIR=reports
